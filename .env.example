# Configuración para clonar/desplegar tu propia instancia de m3

# 1. Tu proyecto Supabase (PostgreSQL + Auth)
# Obtené estas claves en Supabase -> Project Settings -> API
VITE_SUPABASE_PROJECT_ID="tu-project-id"
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="tu-anon-key-publica"

# 2. Si corrés Supabase localmente con Docker:
# VITE_SUPABASE_URL="http://127.0.0.1:54421"
# VITE_SUPABASE_PUBLISHABLE_KEY="tu-local-anon-key"

# 3. Control de Acceso (Instancia Personal vs Compartida)
# Seteá en "false" para evitar que terceros se registren y usen tu Supabase.
# Seteá en "true" solo la primera vez que vayas a crear tu usuario administrador.
VITE_ENABLE_SIGNUP="false"

# 4. Bot de WhatsApp con IA (Opcional - Supabase Secrets en Edge Functions)
# Estas claves NUNCA van en el frontend. Cada usuario las configura en su propio Supabase Dashboard:
# -> Supabase Dashboard -> Settings -> Edge Functions / Vault:
# WHATSAPP_ACCESS_TOKEN="tu-meta-cloud-api-token"
# WHATSAPP_PHONE_NUMBER_ID="tu-phone-number-id-de-meta"
# WHATSAPP_VERIFY_TOKEN="un-token-secreto-elegido-por-vos"
# GEMINI_API_KEY="tu-clave-gratuita-de-google-ai-studio"

